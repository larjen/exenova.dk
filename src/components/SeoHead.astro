---
/**
 * @file SeoHead.astro
 * @description SEO meta tags and head elements for the document.
 * Extracts viewport, charset, title, description, and font preloading from BaseLayout.
 * Implements a modern scalable favicon stack and rich social sharing meta tags (Open Graph).
 * @property {string} title - Page title for the <title> tag
 * @property {string} [description] - SEO meta description
 * @property {string} image - The Open Graph image URL (provided by BaseLayout)
 */
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image: string;
}

const { title, description = SITE_CONFIG.defaultDescription, image } = Astro.props;

// Construct absolute canonical URL
const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.siteUrl);
// Construct absolute image URL for social sharing
const socialImageURL = new URL(image, SITE_CONFIG.siteUrl);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_CONFIG.authorName} />

<link rel="canonical" href={canonicalURL} />

{SITE_CONFIG.useSiteMap && <link rel="sitemap" href="/sitemap-index.xml" />}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Exenova" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Inter:wght@300;400;500&family=Lora:ital,wght@0,400..700;1,400..700&display=block"
  rel="stylesheet"
/>
