---
/**
 * @file [slug].astro
 * @description Dynamic route rendering individual note articles.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Article from '../../components/Article.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import RelatedNotes from '../../components/RelatedNotes.astro';
import { getRelatedNotes } from '../../utils/content';
import { formatDate } from '../../utils/formatters';
import { SITE_CONFIG } from '../../config/site';

/**
 * @description Generates static paths for all published notes.
 * @returns {Promise<any[]>} Array of route parameters and props.
 */
export async function getStaticPaths(): Promise<any[]> {
  const { getPublishedNotes } = await import('../../utils/content');
  const notes = await getPublishedNotes();
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'notes'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const relatedNotes = await getRelatedNotes(entry);
---

<BaseLayout
  title={`${entry.data.title} | ${SITE_CONFIG.authorName}`}
  description={entry.data.description}
  currentPath={Astro.url.pathname}
  searchable={true}
  as="article"
  currentTitle={entry.data.title}
>
  {/* Pagefind Indexing Boundary: Isolates semantic article content from global UI chrome */}
  <div data-pagefind-body class="contents">
    <ArticleHeader
      title={entry.data.title}
      description={entry.data.description}
      date={formatDate(entry.data.date)}
      tags={entry.data.tags}
    />

    <Article>
      <Content />
    </Article>
  </div>

  <RelatedNotes notes={relatedNotes} />
</BaseLayout>
